OPENAI_API_KEY_STAGE1=
OPENAI_API_KEY_STAGE2=
GEMINI_API_KEY_STAGE1=
GEMINI_API_KEY_STAGE2=
ANTHROPIC_API_KEY_STAGE1=
ANTHROPIC_API_KEY_STAGE2=
CHAIRMAN_API_KEY=

# Configurable model snapshots. Record exact values with experiment results.
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-3.1-pro-preview
ANTHROPIC_MODEL=claude-sonnet-4-6
CHAIRMAN_MODEL=gemini-3.1-pro-preview
NANO_BANANA_PRO_API_KEY=gemini-3.1-pro-preview


# Image requests can take longer than Council text requests.
VIFA_IMAGE_REQUEST_TIMEOUT_SECONDS=300

# Council execution settings.
VIFA_TEMPERATURE=0.7
VIFA_REQUEST_TIMEOUT_SECONDS=120
VIFA_RETRY_BASE_DELAY_SECONDS=1
VIFA_MAX_RETRIES=3

# API and upload settings. The frontend currently expects backend port 8000.
VIFA_HOST=127.0.0.1
VIFA_PORT=8000
VIFA_PUBLIC_BACKEND_URL=http://localhost:8000
VIFA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VIFA_MAX_UPLOAD_BYTES=10485760